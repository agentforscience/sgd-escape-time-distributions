{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgZVa5j9h7XbhaUFLRJyL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016ZjWbJDa95e3sAfoaSXvZq","name":"Bash","input":{"command":"pwd\ncat > src/survival.py <<'EOF'\n\"\"\"Interval-censored parametric survival fits for escape-time data.\n\nAn observation is (lo, hi]: the event is known to lie between two checks.\nRight-censored replicas have hi = inf and lo = the last time checked.\n\"\"\"\nimport numpy as np\nfrom scipy import optimize, stats, special\n\n\ndef _log_diff(log_a, log_b):\n    \"\"\"log(exp(log_a) - exp(log_b)) for log_a >= log_b, safely.\"\"\"\n    d = np.minimum(log_b - log_a, -1e-300)\n    return log_a + np.log(-np.expm1(d))\n\n\ndef _ll_from_logsf(logsf, lo, hi):\n    \"\"\"Sum of log-likelihood given a log survival function.\"\"\"\n    ev = np.isfinite(hi)\n    ll = 0.0\n    if ev.any():\n        ll += _log_diff(logsf(lo[ev]), logsf(hi[ev])).sum()\n    if (~ev).any():\n        ll += logsf(lo[~ev]).sum()\n    return ll\n\n\ndef _weibull_logsf(lam, k):\n    return lambda t: -np.power(np.maximum(t, 0.0) / lam, k)\n\n\ndef _lognorm_logsf(mu, s):\n    return lambda t: stats.norm.logsf((np.log(np.maximum(t, 1e-300)) - mu) / s)\n\n\ndef _gamma_logsf(a, scale):\n    return lambda t: np.log(np.maximum(special.gammaincc(a, np.maximum(t, 0.0) / scale), 1e-300))\n\n\ndef _shifted_exp_logsf(t0, lam):\n    return lambda t: -np.maximum(t - t0, 0.0) / lam\n\n\ndef init_scale(lo, hi):\n    \"\"\"Crude scale: exponential MLE with censored exposure.\"\"\"\n    ev = np.isfinite(hi)\n    mid = np.where(ev, 0.5 * (lo + hi), lo)\n    return max(mid.sum() / max(ev.sum(), 1), 1e-9)\n\n\ndef fit_all(lo, hi):\n    \"\"\"Fit exponential, Weibull, gamma, lognormal, shifted exponential.\n\n    Returns a dict of per-model params, ll, aic, plus the LRT p-value of k=1.\n    \"\"\"\n    lo = np.asarray(lo, float)\n    hi = np.asarray(hi, float)\n    n = len(lo)\n    s0 = init_scale(lo, hi)\n    out = {'n': n, 'n_events': int(np.isfinite(hi).sum())}\n\n    def run(nll, x0s):\n        best = None\n        for x0 in x0s:\n            r = optimize.minimize(nll, x0, method='Nelder-Mead',\n                                  options=dict(xatol=1e-4, fatol=1e-4, maxiter=2000))\n            if best is None or r.fun < best.fun:\n                best = r\n        return best\n\n    r = optimize.minimize_scalar(\n        lambda u: -_ll_from_logsf(_weibull_logsf(np.exp(u), 1.0), lo, hi),\n        bounds=(np.log(s0) - 6, np.log(s0) + 6), method='bounded')\n    out['exp'] = dict(lam=float(np.exp(r.x)), ll=float(-r.fun), aic=float(2 * r.fun + 2))\n\n    r = run(lambda x: -_ll_from_logsf(_weibull_logsf(np.exp(x[0]), np.exp(x[1])), lo, hi),\n            [[np.log(s0), 0.0], [np.log(s0), -0.5], [np.log(s0), 0.7]])\n    out['weibull'] = dict(lam=float(np.exp(r.x[0])), k=float(np.exp(r.x[1])),\n                          ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    r = run(lambda x: -_ll_from_logsf(_gamma_logsf(np.exp(x[0]), np.exp(x[1])), lo, hi),\n            [[0.0, np.log(s0)], [1.0, np.log(s0) - 1.0]])\n    out['gamma'] = dict(a=float(np.exp(r.x[0])), scale=float(np.exp(r.x[1])),\n                        ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    r = run(lambda x: -_ll_from_logsf(_lognorm_logsf(x[0], np.exp(x[1])), lo, hi),\n            [[np.log(s0), 0.0], [np.log(s0), -1.0]])\n    out['lognormal'] = dict(mu=float(r.x[0]), s=float(np.exp(r.x[1])),\n                            ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    # Shifted exponential: no mass before t0 (a pure dead time), so t0 <= earliest upper bound.\n    tmax0 = float(np.min(hi[np.isfinite(hi)])) if np.isfinite(hi).any() else float(lo.min())\n    r = run(lambda x: -_ll_from_logsf(\n        _shifted_exp_logsf(tmax0 * special.expit(x[0]), np.exp(x[1])), lo, hi),\n        [[-1.0, np.log(s0)], [1.0, np.log(s0)]])\n    out['shifted_exp'] = dict(t0=float(tmax0 * special.expit(r.x[0])), lam=float(np.exp(r.x[1])),\n                              ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    lrt = 2 * (out['weibull']['ll'] - out['exp']['ll'])\n    out['lrt_k1_stat'] = float(max(lrt, 0.0))\n    out['lrt_k1_p'] = float(stats.chi2.sf(max(lrt, 0.0), 1))\n    models = ['exp', 'weibull', 'gamma', 'lognormal', 'shifted_exp']\n    out['best_model'] = min(models, key=lambda m: out[m]['aic'])\n    return out\n\n\ndef fit_weibull(lo, hi):\n    \"\"\"Weibull-only MLE (fast; used inside bootstraps). Returns (lam, k).\"\"\"\n    s0 = init_scale(lo, hi)\n    r = optimize.minimize(\n        lambda x: -_ll_from_logsf(_weibull_logsf(np.exp(x[0]), np.exp(x[1])), lo, hi),\n        [np.log(s0), 0.0], method='Nelder-Mead', options=dict(xatol=1e-3, fatol=1e-3, maxiter=600))\n    return float(np.exp(r.x[0])), float(np.exp(r.x[1]))\n\n\ndef bootstrap_k(lo, hi, n_boot=200, seed=0):\n    \"\"\"Replica-level percentile bootstrap CI for Weibull k and for log-median.\"\"\"\n    rng = np.random.default_rng(seed)\n    n = len(lo)\n    ks, meds = [], []\n    for _ in range(n_boot):\n        i = rng.integers(0, n, n)\n        if not np.isfinite(hi[i]).any():\n            continue\n        lam, k = fit_weibull(lo[i], hi[i])\n        ks.append(k)\n        meds.append(lam * np.log(2) ** (1 / k))\n    return (*np.percentile(ks, [2.5, 97.5]), *np.percentile(meds, [2.5, 97.5]))\n\n\ndef km_median(lo, hi):\n    \"\"\"Median by Turnbull-free midpoint Kaplan-Meier; inf if survival never reaches .5.\"\"\"\n    ev = np.isfinite(hi)\n    t = np.where(ev, 0.5 * (lo + hi), lo)\n    o = np.argsort(t)\n    t, ev = t[o], ev[o]\n    at_risk = len(t)\n    s = 1.0\n    for ti, e in zip(t, ev):\n        if e:\n            s *= 1 - 1 / at_risk\n        at_risk -= 1\n        if s <= 0.5:\n            return float(ti)\n    return float('inf')\n\n\ndef weibull_mean(lam, k):\n    return float(lam * special.gamma(1 + 1 / k))\n\n\nif __name__ == '__main__':\n    # Recovery test: interval-censored Weibull data with k in {.7,1,1.3}, 25% censoring.\n    rng = np.random.default_rng(0)\n    for k_true in [0.7, 1.0, 1.3]:\n        ks, ps = [], []\n        for rep in range(40):\n            t = 1000 * rng.weibull(k_true, 300)\n            c = np.quantile(t, 0.75)\n            dt = 50\n            lo = np.floor(np.minimum(t, c) / dt) * dt\n            hi = np.where(t < c, lo + dt, np.inf)\n            f = fit_all(lo, hi)\n            ks.append(f['weibull']['k'])\n            ps.append(f['lrt_k1_p'])\n        print(f'k_true={k_true}: mean k_hat={np.mean(ks):.3f} sd={np.std(ks):.3f} '\n              f'reject_k1={np.mean(np.array(ps) < .05):.2f}')\nEOF\ncat > src/e0_kramers.py <<'EOF'\n\"\"\"E0: controlled double well with an exact Kramers rate.\n\nValidates the simulator and estimators, and maps which mechanism produces Weibull k != 1:\n  - start-up transient (start at the minimum vs quasi-stationary start),\n  - low barrier (Delta/T small),\n  - pooled heterogeneity (mixture of well widths),\n  - loss-proportional noise (Mori-type).\nV(x) = Delta (x_1^2/w^2 - 1)^2 + (c/2) sum_{j>=2} x_j^2.  Start in the right well; escape = x_1 < -w/2.\nGaussian minibatch noise of variance sigma^2/B is the CLT limit of with-replacement sampling.\n\"\"\"\nimport json, os, sys, time\nimport numpy as np\nfrom multiprocessing import Pool\nsys.path.insert(0, os.path.dirname(__file__))\nimport survival as sv\n\nOUT = 'results/e0'\nR = 1000\nD = 8\nC_ORTH = 4.0\nETA = 0.002\n\n\ndef grad_v(x, delta, w):\n    g = C_ORTH * x\n    g[:, 0] = 4 * delta / w**2 * x[:, 0] * (x[:, 0]**2 / w**2 - 1)\n    return g\n\n\ndef loss_v(x, delta, w):\n    return delta * (x[:, 0]**2 / w**2 - 1)**2 + 0.5 * C_ORTH * (x[:, 1:]**2).sum(1)\n\n\ndef simulate(opt, delta, w, T, seed, t_max, start='min', noise='additive', aligned=False, eta_adam=None, r=R):\n    \"\"\"Run replicas to first exit. T = eta sigma^2/2 sets sigma (B=1 w.l.o.g.).\"\"\"\n    rng = np.random.default_rng(seed)\n    sigma = np.full(D, np.sqrt(2 * T / ETA))\n    a = 8 * delta / w**2\n    if aligned:  # H-aligned noise: variance proportional to the curvature in each direction\n        sig2 = np.full(D, C_ORTH)\n        sig2[0] = a\n        sigma = np.sqrt(sig2 / sig2.mean()) * sigma\n    x = np.zeros((r, D))\n    x[:, 0] = w\n    if start == 'qsd':  # Gaussian approximation of the well's stationary law\n        std = np.sqrt(T / np.r_[a, np.full(D - 1, C_ORTH)])\n        if aligned:\n            std = sigma * np.sqrt(ETA / 2 / np.r_[a, np.full(D - 1, C_ORTH)])\n        x += rng.normal(size=x.shape) * std\n    t = np.full(r, np.inf)\n    alive = np.arange(r)\n    if opt == 'adam':\n        m, v = np.zeros((r, D)), np.zeros((r, D))\n        b1, b2 = 0.9, 0.999\n    for step in range(1, t_max + 1):\n        g = grad_v(x, delta, w)\n        n = rng.normal(size=x.shape) * sigma\n        if noise == 'loss':  # noise std scales with sqrt(1 + V/delta)\n            n *= np.sqrt(1 + loss_v(x, delta, w) / delta)[:, None]\n        g = g + n\n        if opt == 'sgd':\n            x -= ETA * g\n        else:\n            m = b1 * m + (1 - b1) * g\n            v = b2 * v + (1 - b2) * g * g\n            x -= eta_adam * (m / (1 - b1**step)) / (np.sqrt(v / (1 - b2**step)) + 1e-8)\n        done = x[:, 0] < -w / 2\n        if done.any():\n            t[alive[done]] = step\n            keep = ~done\n            x, alive = x[keep], alive[keep]\n            if opt == 'adam':\n                m, v = m[keep], v[keep]\n            if len(alive) == 0:\n                break\n    return t, step\n\n\ndef job(cfg):\n    t, last = simulate(cfg['opt'], cfg['delta'], cfg['w'], cfg['T'], cfg['seed'], cfg['t_max'],\n                       cfg.get('start', 'min'), cfg.get('noise', 'additive'), cfg.get('aligned', False),\n                       cfg.get('eta_adam'))\n    lo = np.where(np.isfinite(t), t - 1, cfg['t_max'])\n    hi = t.copy()\n    return cfg, lo, hi\n\n\ndef kramers(delta, w, T):\n    a, b = 8 * delta / w**2, 4 * delta / w**2\n    return 2 * np.pi / (ETA * np.sqrt(a * b)) * np.exp(delta / T)\n\n\ndef main():\n    os.makedirs(OUT, exist_ok=True)\n    cfgs = []\n    seed = 100\n    # Kramers validation & transient map: barrier/T grid, three widths, two starts.\n    for w in [0.5, 1.0, 2.0]:\n        for bt in [1, 2, 3, 4, 5, 6]:\n            for start in ['min', 'qsd']:\n                seed += 1\n                T = 1.0 / bt\n                cfgs.append(dict(exp='kramers', opt='sgd', delta=1.0, w=w, T=T, start=start, seed=seed,\n                                 t_max=int(min(80 * kramers(1.0, w, T) + 2000, 1200000))))\n    # Noise model: loss-proportional noise, tests how the batch-size law changes.\n    for bt in [1, 2, 3, 4, 5, 6]:\n        seed += 1\n        cfgs.append(dict(exp='lossnoise', opt='sgd', delta=1.0, w=1.0, T=1.0 / bt, noise='loss',\n                         start='min', seed=seed, t_max=1200000))\n    # Adam at matched temperature: eta_A sigma/2 = T for isotropic noise (see REPORT).\n    for w in [0.5, 2.0]:\n        for aligned in [False, True]:\n            for bt in [3, 4, 5]:\n                T = 1.0 / bt\n                sig = np.sqrt(2 * T / ETA)\n                if aligned:  # sigma in the stiff/escape coordinate differs; match on coordinate 1\n                    a = 8 / w**2\n                    sig2 = np.full(D, C_ORTH); sig2[0] = a\n                    sig = sig * np.sqrt(a / sig2.mean())\n                for opt in ['sgd', 'adam']:\n                    seed += 1\n                    cfgs.append(dict(exp='adam', opt=opt, delta=1.0, w=w, T=T, aligned=aligned, start='min', seed=seed,\n                                     eta_adam=ETA * sig, t_max=400000))\n    print(len(cfgs), 'configs', flush=True)\n    t0 = time.time()\n    rows = []\n    with Pool(12) as p:\n        for cfg, lo, hi in p.imap_unordered(job, cfgs):\n            name = f\"{cfg['exp']}_{cfg['seed']}\"\n            np.savez(f'{OUT}/{name}.npz', lo=lo, hi=hi)\n            f = sv.fit_all(lo, hi)\n            mean_cens = float(np.where(np.isfinite(hi), hi, lo).mean())\n            rows.append(dict(cfg, name=name, fit=f, mean_obs=mean_cens,\n                             kramers=kramers(cfg['delta'], cfg['w'], cfg['T'])))\n            print(f\"{name} w={cfg['w']} bt={1/cfg['T']:.0f} {cfg['opt']} {cfg.get('start')} \"\n                  f\"events={f['n_events']} mean={mean_cens:.0f} kr={rows[-1]['kramers']:.0f} \"\n                  f\"k={f['weibull']['k']:.3f} best={f['best_model']} {time.time()-t0:.0f}s\", flush=True)\n            json.dump(rows, open(f'{OUT}/summary.json', 'w'), indent=1)\n\n\nif __name__ == '__main__':\n    main()\nEOF\nsource .venv/bin/activate; export NUMPY_MADVISE_HUGEPAGE=0 OMP_NUM_THREADS=1\ntimeout 110 python src/survival.py\nnohup python src/e0_kramers.py > logs/e0.log 2>&1 &\nsleep 1; echo launched","description":"Write and test survival estimators, launch E0 double-well experiment","timeout":130000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5666,"cache_read_input_tokens":88072,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5666},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8b0894c3-d91e-45a5-b742-1e1609c0e675","uuid":"9ea20bb7-4cac-43cc-a5ef-d6479d2a9557","timestamp":"2026-10-31T02:04:41.685Z","request_id":"req_011CgZVa5VWwU6WRiScAkeeL","wire_tool_inputs":{"toolu_016ZjWbJDa95e3sAfoaSXvZq":{"command":"cd /data/summereunann/neurico-workspaces/sgd_escape_time_distributions_20261030_140000_math01 && pwd\ncat > src/survival.py <<'EOF'\n\"\"\"Interval-censored parametric survival fits for escape-time data.\n\nAn observation is (lo, hi]: the event is known to lie between two checks.\nRight-censored replicas have hi = inf and lo = the last time checked.\n\"\"\"\nimport numpy as np\nfrom scipy import optimize, stats, special\n\n\ndef _log_diff(log_a, log_b):\n    \"\"\"log(exp(log_a) - exp(log_b)) for log_a >= log_b, safely.\"\"\"\n    d = np.minimum(log_b - log_a, -1e-300)\n    return log_a + np.log(-np.expm1(d))\n\n\ndef _ll_from_logsf(logsf, lo, hi):\n    \"\"\"Sum of log-likelihood given a log survival function.\"\"\"\n    ev = np.isfinite(hi)\n    ll = 0.0\n    if ev.any():\n        ll += _log_diff(logsf(lo[ev]), logsf(hi[ev])).sum()\n    if (~ev).any():\n        ll += logsf(lo[~ev]).sum()\n    return ll\n\n\ndef _weibull_logsf(lam, k):\n    return lambda t: -np.power(np.maximum(t, 0.0) / lam, k)\n\n\ndef _lognorm_logsf(mu, s):\n    return lambda t: stats.norm.logsf((np.log(np.maximum(t, 1e-300)) - mu) / s)\n\n\ndef _gamma_logsf(a, scale):\n    return lambda t: np.log(np.maximum(special.gammaincc(a, np.maximum(t, 0.0) / scale), 1e-300))\n\n\ndef _shifted_exp_logsf(t0, lam):\n    return lambda t: -np.maximum(t - t0, 0.0) / lam\n\n\ndef init_scale(lo, hi):\n    \"\"\"Crude scale: exponential MLE with censored exposure.\"\"\"\n    ev = np.isfinite(hi)\n    mid = np.where(ev, 0.5 * (lo + hi), lo)\n    return max(mid.sum() / max(ev.sum(), 1), 1e-9)\n\n\ndef fit_all(lo, hi):\n    \"\"\"Fit exponential, Weibull, gamma, lognormal, shifted exponential.\n\n    Returns a dict of per-model params, ll, aic, plus the LRT p-value of k=1.\n    \"\"\"\n    lo = np.asarray(lo, float)\n    hi = np.asarray(hi, float)\n    n = len(lo)\n    s0 = init_scale(lo, hi)\n    out = {'n': n, 'n_events': int(np.isfinite(hi).sum())}\n\n    def run(nll, x0s):\n        best = None\n        for x0 in x0s:\n            r = optimize.minimize(nll, x0, method='Nelder-Mead',\n                                  options=dict(xatol=1e-4, fatol=1e-4, maxiter=2000))\n            if best is None or r.fun < best.fun:\n                best = r\n        return best\n\n    r = optimize.minimize_scalar(\n        lambda u: -_ll_from_logsf(_weibull_logsf(np.exp(u), 1.0), lo, hi),\n        bounds=(np.log(s0) - 6, np.log(s0) + 6), method='bounded')\n    out['exp'] = dict(lam=float(np.exp(r.x)), ll=float(-r.fun), aic=float(2 * r.fun + 2))\n\n    r = run(lambda x: -_ll_from_logsf(_weibull_logsf(np.exp(x[0]), np.exp(x[1])), lo, hi),\n            [[np.log(s0), 0.0], [np.log(s0), -0.5], [np.log(s0), 0.7]])\n    out['weibull'] = dict(lam=float(np.exp(r.x[0])), k=float(np.exp(r.x[1])),\n                          ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    r = run(lambda x: -_ll_from_logsf(_gamma_logsf(np.exp(x[0]), np.exp(x[1])), lo, hi),\n            [[0.0, np.log(s0)], [1.0, np.log(s0) - 1.0]])\n    out['gamma'] = dict(a=float(np.exp(r.x[0])), scale=float(np.exp(r.x[1])),\n                        ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    r = run(lambda x: -_ll_from_logsf(_lognorm_logsf(x[0], np.exp(x[1])), lo, hi),\n            [[np.log(s0), 0.0], [np.log(s0), -1.0]])\n    out['lognormal'] = dict(mu=float(r.x[0]), s=float(np.exp(r.x[1])),\n                            ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    # Shifted exponential: no mass before t0 (a pure dead time), so t0 <= earliest upper bound.\n    tmax0 = float(np.min(hi[np.isfinite(hi)])) if np.isfinite(hi).any() else float(lo.min())\n    r = run(lambda x: -_ll_from_logsf(\n        _shifted_exp_logsf(tmax0 * special.expit(x[0]), np.exp(x[1])), lo, hi),\n        [[-1.0, np.log(s0)], [1.0, np.log(s0)]])\n    out['shifted_exp'] = dict(t0=float(tmax0 * special.expit(r.x[0])), lam=float(np.exp(r.x[1])),\n                              ll=float(-r.fun), aic=float(2 * r.fun + 4))\n\n    lrt = 2 * (out['weibull']['ll'] - out['exp']['ll'])\n    out['lrt_k1_stat'] = float(max(lrt, 0.0))\n    out['lrt_k1_p'] = float(stats.chi2.sf(max(lrt, 0.0), 1))\n    models = ['exp', 'weibull', 'gamma', 'lognormal', 'shifted_exp']\n    out['best_model'] = min(models, key=lambda m: out[m]['aic'])\n    return out\n\n\ndef fit_weibull(lo, hi):\n    \"\"\"Weibull-only MLE (fast; used inside bootstraps). Returns (lam, k).\"\"\"\n    s0 = init_scale(lo, hi)\n    r = optimize.minimize(\n        lambda x: -_ll_from_logsf(_weibull_logsf(np.exp(x[0]), np.exp(x[1])), lo, hi),\n        [np.log(s0), 0.0], method='Nelder-Mead', options=dict(xatol=1e-3, fatol=1e-3, maxiter=600))\n    return float(np.exp(r.x[0])), float(np.exp(r.x[1]))\n\n\ndef bootstrap_k(lo, hi, n_boot=200, seed=0):\n    \"\"\"Replica-level percentile bootstrap CI for Weibull k and for log-median.\"\"\"\n    rng = np.random.default_rng(seed)\n    n = len(lo)\n    ks, meds = [], []\n    for _ in range(n_boot):\n        i = rng.integers(0, n, n)\n        if not np.isfinite(hi[i]).any():\n            continue\n        lam, k = fit_weibull(lo[i], hi[i])\n        ks.append(k)\n        meds.append(lam * np.log(2) ** (1 / k))\n    return (*np.percentile(ks, [2.5, 97.5]), *np.percentile(meds, [2.5, 97.5]))\n\n\ndef km_median(lo, hi):\n    \"\"\"Median by Turnbull-free midpoint Kaplan-Meier; inf if survival never reaches .5.\"\"\"\n    ev = np.isfinite(hi)\n    t = np.where(ev, 0.5 * (lo + hi), lo)\n    o = np.argsort(t)\n    t, ev = t[o], ev[o]\n    at_risk = len(t)\n    s = 1.0\n    for ti, e in zip(t, ev):\n        if e:\n            s *= 1 - 1 / at_risk\n        at_risk -= 1\n        if s <= 0.5:\n            return float(ti)\n    return float('inf')\n\n\ndef weibull_mean(lam, k):\n    return float(lam * special.gamma(1 + 1 / k))\n\n\nif __name__ == '__main__':\n    # Recovery test: interval-censored Weibull data with k in {.7,1,1.3}, 25% censoring.\n    rng = np.random.default_rng(0)\n    for k_true in [0.7, 1.0, 1.3]:\n        ks, ps = [], []\n        for rep in range(40):\n            t = 1000 * rng.weibull(k_true, 300)\n            c = np.quantile(t, 0.75)\n            dt = 50\n            lo = np.floor(np.minimum(t, c) / dt) * dt\n            hi = np.where(t < c, lo + dt, np.inf)\n            f = fit_all(lo, hi)\n            ks.append(f['weibull']['k'])\n            ps.append(f['lrt_k1_p'])\n        print(f'k_true={k_true}: mean k_hat={np.mean(ks):.3f} sd={np.std(ks):.3f} '\n              f'reject_k1={np.mean(np.array(ps) < .05):.2f}')\nEOF\ncat > src/e0_kramers.py <<'EOF'\n\"\"\"E0: controlled double well with an exact Kramers rate.\n\nValidates the simulator and estimators, and maps which mechanism produces Weibull k != 1:\n  - start-up transient (start at the minimum vs quasi-stationary start),\n  - low barrier (Delta/T small),\n  - pooled heterogeneity (mixture of well widths),\n  - loss-proportional noise (Mori-type).\nV(x) = Delta (x_1^2/w^2 - 1)^2 + (c/2) sum_{j>=2} x_j^2.  Start in the right well; escape = x_1 < -w/2.\nGaussian minibatch noise of variance sigma^2/B is the CLT limit of with-replacement sampling.\n\"\"\"\nimport json, os, sys, time\nimport numpy as np\nfrom multiprocessing import Pool\nsys.path.insert(0, os.path.dirname(__file__))\nimport survival as sv\n\nOUT = 'results/e0'\nR = 1000\nD = 8\nC_ORTH = 4.0\nETA = 0.002\n\n\ndef grad_v(x, delta, w):\n    g = C_ORTH * x\n    g[:, 0] = 4 * delta / w**2 * x[:, 0] * (x[:, 0]**2 / w**2 - 1)\n    return g\n\n\ndef loss_v(x, delta, w):\n    return delta * (x[:, 0]**2 / w**2 - 1)**2 + 0.5 * C_ORTH * (x[:, 1:]**2).sum(1)\n\n\ndef simulate(opt, delta, w, T, seed, t_max, start='min', noise='additive', aligned=False, eta_adam=None, r=R):\n    \"\"\"Run replicas to first exit. T = eta sigma^2/2 sets sigma (B=1 w.l.o.g.).\"\"\"\n    rng = np.random.default_rng(seed)\n    sigma = np.full(D, np.sqrt(2 * T / ETA))\n    a = 8 * delta / w**2\n    if aligned:  # H-aligned noise: variance proportional to the curvature in each direction\n        sig2 = np.full(D, C_ORTH)\n        sig2[0] = a\n        sigma = np.sqrt(sig2 / sig2.mean()) * sigma\n    x = np.zeros((r, D))\n    x[:, 0] = w\n    if start == 'qsd':  # Gaussian approximation of the well's stationary law\n        std = np.sqrt(T / np.r_[a, np.full(D - 1, C_ORTH)])\n        if aligned:\n            std = sigma * np.sqrt(ETA / 2 / np.r_[a, np.full(D - 1, C_ORTH)])\n        x += rng.normal(size=x.shape) * std\n    t = np.full(r, np.inf)\n    alive = np.arange(r)\n    if opt == 'adam':\n        m, v = np.zeros((r, D)), np.zeros((r, D))\n        b1, b2 = 0.9, 0.999\n    for step in range(1, t_max + 1):\n        g = grad_v(x, delta, w)\n        n = rng.normal(size=x.shape) * sigma\n        if noise == 'loss':  # noise std scales with sqrt(1 + V/delta)\n            n *= np.sqrt(1 + loss_v(x, delta, w) / delta)[:, None]\n        g = g + n\n        if opt == 'sgd':\n            x -= ETA * g\n        else:\n            m = b1 * m + (1 - b1) * g\n            v = b2 * v + (1 - b2) * g * g\n            x -= eta_adam * (m / (1 - b1**step)) / (np.sqrt(v / (1 - b2**step)) + 1e-8)\n        done = x[:, 0] < -w / 2\n        if done.any():\n            t[alive[done]] = step\n            keep = ~done\n            x, alive = x[keep], alive[keep]\n            if opt == 'adam':\n                m, v = m[keep], v[keep]\n            if len(alive) == 0:\n                break\n    return t, step\n\n\ndef job(cfg):\n    t, last = simulate(cfg['opt'], cfg['delta'], cfg['w'], cfg['T'], cfg['seed'], cfg['t_max'],\n                       cfg.get('start', 'min'), cfg.get('noise', 'additive'), cfg.get('aligned', False),\n                       cfg.get('eta_adam'))\n    lo = np.where(np.isfinite(t), t - 1, cfg['t_max'])\n    hi = t.copy()\n    return cfg, lo, hi\n\n\ndef kramers(delta, w, T):\n    a, b = 8 * delta / w**2, 4 * delta / w**2\n    return 2 * np.pi / (ETA * np.sqrt(a * b)) * np.exp(delta / T)\n\n\ndef main():\n    os.makedirs(OUT, exist_ok=True)\n    cfgs = []\n    seed = 100\n    # Kramers validation & transient map: barrier/T grid, three widths, two starts.\n    for w in [0.5, 1.0, 2.0]:\n        for bt in [1, 2, 3, 4, 5, 6]:\n            for start in ['min', 'qsd']:\n                seed += 1\n                T = 1.0 / bt\n                cfgs.append(dict(exp='kramers', opt='sgd', delta=1.0, w=w, T=T, start=start, seed=seed,\n                                 t_max=int(min(80 * kramers(1.0, w, T) + 2000, 1200000))))\n    # Noise model: loss-proportional noise, tests how the batch-size law changes.\n    for bt in [1, 2, 3, 4, 5, 6]:\n        seed += 1\n        cfgs.append(dict(exp='lossnoise', opt='sgd', delta=1.0, w=1.0, T=1.0 / bt, noise='loss',\n                         start='min', seed=seed, t_max=1200000))\n    # Adam at matched temperature: eta_A sigma/2 = T for isotropic noise (see REPORT).\n    for w in [0.5, 2.0]:\n        for aligned in [False, True]:\n            for bt in [3, 4, 5]:\n                T = 1.0 / bt\n                sig = np.sqrt(2 * T / ETA)\n                if aligned:  # sigma in the stiff/escape coordinate differs; match on coordinate 1\n                    a = 8 / w**2\n                    sig2 = np.full(D, C_ORTH); sig2[0] = a\n                    sig = sig * np.sqrt(a / sig2.mean())\n                for opt in ['sgd', 'adam']:\n                    seed += 1\n                    cfgs.append(dict(exp='adam', opt=opt, delta=1.0, w=w, T=T, aligned=aligned, start='min', seed=seed,\n                                     eta_adam=ETA * sig, t_max=400000))\n    print(len(cfgs), 'configs', flush=True)\n    t0 = time.time()\n    rows = []\n    with Pool(12) as p:\n        for cfg, lo, hi in p.imap_unordered(job, cfgs):\n            name = f\"{cfg['exp']}_{cfg['seed']}\"\n            np.savez(f'{OUT}/{name}.npz', lo=lo, hi=hi)\n            f = sv.fit_all(lo, hi)\n            mean_cens = float(np.where(np.isfinite(hi), hi, lo).mean())\n            rows.append(dict(cfg, name=name, fit=f, mean_obs=mean_cens,\n                             kramers=kramers(cfg['delta'], cfg['w'], cfg['T'])))\n            print(f\"{name} w={cfg['w']} bt={1/cfg['T']:.0f} {cfg['opt']} {cfg.get('start')} \"\n                  f\"events={f['n_events']} mean={mean_cens:.0f} kr={rows[-1]['kramers']:.0f} \"\n                  f\"k={f['weibull']['k']:.3f} best={f['best_model']} {time.time()-t0:.0f}s\", flush=True)\n            json.dump(rows, open(f'{OUT}/summary.json', 'w'), indent=1)\n\n\nif __name__ == '__main__':\n    main()\nEOF\nsource .venv/bin/activate; export NUMPY_MADVISE_HUGEPAGE=0 OMP_NUM_THREADS=1\ntimeout 110 python src/survival.py\nnohup python src/e0_kramers.py > logs/e0.log 2>&1 &\nsleep 1; echo launched","description":"Write and test survival estimators, launch E0 double-well experiment","timeout":130000}},"wire_ingest_context":{"toolu_016ZjWbJDa95e3sAfoaSXvZq":{"cwd":"/data/summereunann/neurico-workspaces/sgd_escape_time_distributions_20261030_140000_math01"}}}

.norm().item())\n            g2 = net.grad((th + d)[None])[0]\n            if g2.norm() < g.norm():\n                th, g = th + d, g2\n                trust = min(trust * 2, 1.0)\n                break\n            trust *= 0.4\n        if trust <= 1e-7:\n            break\n    if not ok:\n        print(f'w{wid} t{t} no-conv k0={k0} gn={gn:.1e} it={it} {time.time()-t0:.0f}s', flush=True)\n        continue\n    ev = torch.linalg.eigvalsh(net.hessian(th)).numpy()\n    idx = int((ev < -1e-7).sum())\n    L = net.flat_loss_single(th).item()\n    print(f'w{wid} t{t} L={L:.4f} index={idx} ev={ev[:4].round(4)} gn={gn:.1e} it={it} {time.time()-t0:.0f}s', flush=True)\n    if idx >= 2:\n        np.savez(f'results/saddles/{land}_w{wid}_t{t}.npz', th=th.numpy(), ev=ev, L=L, index=idx, gn=gn)\n'''\ns=s.replace(\"Start: mixture of two minima, relaxed briefly by descent. Then d = -V sign-aware |lambda|^-1 V' g, ascending\\nalong the k lowest modes and descending along the rest, with k frozen after a few steps. Converges to a\\ncritical point of index k.\",\"Start: a descent trajectory stopped at a random time, kept only if it has 2-8 negative modes. Then\\nd = -V s |lambda|^-1 V' g, ascending along the k lowest modes and descending along the rest (adaptive trust\\nregion, accepted only if the gradient norm falls). Converges to a critical point of index k.\")\nopen('src/find_saddles.py','w').write(s)\nEOF\nfor w in 0 1 2 3 4 5; do nohup python -u src/find_saddles.py S $w 2000 > logs/sad_S_$w.log 2>&1 & sleep 0.3; done\nsleep 120; cat logs/sad_S_*.log | grep -E '^w[0-9]' | cut -c1-100 | tail -12; ls results/saddles | wc -l; for f in logs/worker_*.log; do grep -E '^(done|OOM|FAIL)' $f | tail -1 | cut -c1-100; done; ls results/escape/*.npz | wc -l; nvidia-smi --query-gpu=index,memory.free,utilization.gpu --format=csv,noheader","description":"Run saddle search on a small network; check grid throughput","timeout":150000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,